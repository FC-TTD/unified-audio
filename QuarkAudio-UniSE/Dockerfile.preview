# syntax=docker/dockerfile:1.7
FROM pymss-studio-preview:latest

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    HF_HOME=/models/huggingface \
    GRADIO_SERVER_NAME=0.0.0.0 \
    GRADIO_SERVER_PORT=7860 \
    UNISE_OUTPUT_DIR=/data/outputs

WORKDIR /app

RUN --mount=type=cache,target=/var/cache/apt \
    --mount=type=cache,target=/var/lib/apt \
    apt-get update && apt-get install -y --no-install-recommends \
      ffmpeg \
      libsndfile1 \
    && true

COPY requirements.preview.txt /tmp/requirements.preview.txt
RUN --mount=type=cache,target=/root/.cache/pip \
    python -m pip install -r /tmp/requirements.preview.txt

COPY model /app/model
COPY preview_adapter.py app_preview.py /app/

RUN mkdir -p /data/outputs /models/huggingface

EXPOSE 7860
ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["python", "app_preview.py"]
